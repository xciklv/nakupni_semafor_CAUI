# Zkopírujte na .env a vyplňte klíč. Soubor .env se necommituje.
ANTHROPIC_API_KEY=

# Volitelné (prázdné nebo zakomentované = výchozí hodnota)
# PORT=5678
# SAVE_EXECUTIONS=none        # none = průběhy se neukládají (výchozí v Dockeru), all = ukládají se pro ladění
# QUOTA_PER_DAY=200
# LLM_MODEL_EXTRACT=claude-haiku-5-5
# LLM_MODEL_EXPLAIN=claude-haiku-5-5
# LLM_MODEL_PLAUSIBILITY=claude-sonnet-5-5
# LLM_MODEL_IMAGES=claude-haiku-5-5
# PAGE_READER_URL=off          # čtečka stránek v Dockeru zatím není, marketplace jde přes vložený text
